# Copy to .env for local development. On Vercel, TURSO_DATABASE_URL and
# TURSO_AUTH_TOKEN are injected by the Turso marketplace integration; you only
# add JWT_SECRET (and optionally ADMIN_EMAILS) in the project settings.

# libsql URL: a local file for dev/self-host, or libsql://... for Turso
TURSO_DATABASE_URL=file:./data/app.db

# Only needed for remote Turso databases (leave unset for file: URLs)
# TURSO_AUTH_TOKEN=

# JWT signing secret — use a long random value: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret

# Cookies default to secure on Vercel (always HTTPS). Set false for local
# http dev; set true when self-hosting behind HTTPS.
COOKIE_SECURE=false

# Comma-separated emails that get the ADMIN role on register/login (optional)
ADMIN_EMAILS=
