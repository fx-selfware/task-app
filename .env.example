# Copy to .env for local development. In production, set these on the systemd
# unit (see deploy/task-app.service) or your process manager.

# Path to the SQLite database file (created + migrated automatically on boot)
SQLITE_PATH=./data/app.db

# JWT signing secret — use a long random value: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret

# true when the app is served over HTTPS (production), false for local http
COOKIE_SECURE=false

# Comma-separated emails that get the ADMIN role on register/login (optional)
ADMIN_EMAILS=
