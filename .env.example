# Database
POSTGRES_DB=taskapp
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://taskapp:changeme@db:5432/taskapp

# JWT
JWT_SECRET=change-this-to-a-long-random-secret

# App
NODE_ENV=production
COOKIE_SECURE=true

# Admin (comma-separated emails that get admin role)
ADMIN_EMAILS=

# Domain (used by Caddy for HTTPS)
DOMAIN=task-app-fx.westus2.cloudapp.azure.com
